{
  "name": "@prompton-dev/agent",
  "version": "0.1.1",
  "description": "Prompton DocsAgent for conversational Starlight docs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/agent"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "peerDependencies": {
    "@cloudflare/ai-chat": "^0.10.0",
    "agents": "^0.21.0",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "workers-ai-provider": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "dependencies": {
    "@prompton-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/ai-chat": "^0.10.2",
    "@cloudflare/workers-types": "^5.20260823.1",
    "agents": "^0.21.0",
    "ai": "^7.0.78",
    "typescript": "^7.0.2",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
