{
  "name": "@prompton-dev/starlight",
  "version": "0.1.3",
  "description": "Starlight plugin for Prompton conversational docs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/components/*",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/starlight"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@astrojs/starlight": "^0.35.0 || ^0.36.0 || ^0.37.0 || ^0.38.0 || ^0.39.0 || ^0.40.0 || ^0.41.0",
    "@cloudflare/ai-chat": "^0.10.0",
    "@prompton-dev/ui": "^0.1.2",
    "agents": "^0.21.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@prompton-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.81",
    "@astrojs/starlight": "^0.41.8",
    "@cloudflare/ai-chat": "^0.10.2",
    "@prompton-dev/ui": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "agents": "^0.21.0",
    "astro": "^7.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
