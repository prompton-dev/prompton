---
import Search from "@astrojs/starlight/components/Search.astro";
import AskButton from "./AskButton.astro";
---

<div class="prompton-header-actions">
  <AskButton />
  <Search />
</div>

<script>
  /*
    Escalation row inside the search dialog. A search that finds nothing should
    hand the reader's own words to the agent rather than dead-ending — so the
    typed query rides across into the composer.

    The row is appended to the dialog frame, *outside* Pagefind's own container:
    Pagefind re-renders its results subtree on every keystroke, so anything
    injected in there gets wiped.
  */
  const ASK = "prompton:chat-ask";
  const MIN_QUERY = 2;

  function pagefindInput(dialog: Element): HTMLInputElement | null {
    return dialog.querySelector<HTMLInputElement>("input[type=text], .pagefind-ui__search-input");
  }

  function resultCount(dialog: Element): number {
    return dialog.querySelectorAll(".pagefind-ui__result").length;
  }

  function mount(search: Element) {
    const dialog = search.querySelector("dialog");
    const frame = dialog?.querySelector(".dialog-frame");
    if (!dialog || !frame || frame.querySelector("[data-prompton-search-ask]")) return;

    const row = document.createElement("button");
    row.type = "button";
    row.className = "prompton-search-ask";
    row.hidden = true;
    row.setAttribute("data-prompton-search-ask", "");
    row.innerHTML =
      '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">' +
      '<path d="M8 1.8 9.15 5.1a2 2 0 0 0 1.25 1.25L13.7 7.5l-3.3 1.15a2 2 0 0 0-1.25 1.25L8 13.2l-1.15-3.3A2 2 0 0 0 5.6 8.65L2.3 7.5l3.3-1.15A2 2 0 0 0 6.85 5.1L8 1.8Z" fill="currentColor"/></svg>' +
      '<span class="prompton-search-ask__label"></span>';
    frame.appendChild(row);

    const label = row.querySelector(".prompton-search-ask__label") as HTMLElement;
    let query = "";

    function refresh() {
      const input = pagefindInput(dialog!);
      query = (input?.value ?? "").trim();

      const hidden = query.length < MIN_QUERY;
      if (row.hidden !== hidden) row.hidden = hidden;
      if (hidden) return;

      const empty = resultCount(dialog!) === 0;
      if (row.hasAttribute("data-empty") !== empty) row.toggleAttribute("data-empty", empty);
      const next = empty
        ? `Ask the docs about “${query}”`
        : `Or ask the docs about “${query}”`;
      if (label.textContent !== next) label.textContent = next;
    }

    dialog.addEventListener("input", refresh);

    /*
      Watch only Pagefind's own container. Observing the whole dialog would see
      this row's own updates and re-enter refresh() forever — the row lives in
      the frame, deliberately outside what is observed here.
    */
    const results = dialog.querySelector(".search-container");
    if (results) {
      new MutationObserver(refresh).observe(results, { childList: true, subtree: true });
    }

    row.addEventListener("click", () => {
      if (!query) return;
      dialog.close();
      window.dispatchEvent(new CustomEvent(ASK, { detail: { text: query } }));
    });
  }

  function init() {
    document.querySelectorAll("site-search").forEach(mount);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
