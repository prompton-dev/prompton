---
/**
 * Single header affordance for chat.
 *
 * Replaces the old Browse/Chat pair: the sticky rail is now the primary way in,
 * and the docked panel carries its own close control, so a two-state toggle in
 * the header was saying the same thing twice.
 */
const url = Astro.url;
const isChat = url.searchParams.get("mode") === "chat";

const chatHref = (() => {
  const u = new URL(url);
  u.searchParams.set("mode", "chat");
  return u.pathname + "?" + u.searchParams.toString();
})();
---

<a
  class="prompton-ask"
  href={chatHref}
  data-prompton-ask
  title="Ask the docs (⌘I)"
  aria-current={isChat ? "true" : undefined}
>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
    <path
      d="M8 1.8 9.15 5.1a2 2 0 0 0 1.25 1.25L13.7 7.5l-3.3 1.15a2 2 0 0 0-1.25 1.25L8 13.2l-1.15-3.3A2 2 0 0 0 5.6 8.65L2.3 7.5l3.3-1.15A2 2 0 0 0 6.85 5.1L8 1.8Z"
      fill="currentColor"></path>
  </svg>
  <span>Ask</span>
</a>
