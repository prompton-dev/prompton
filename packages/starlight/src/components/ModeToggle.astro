---
interface Props {
  mode?: "browse" | "chat";
}

const url = Astro.url;
const mode = (url.searchParams.get("mode") === "chat" ? "chat" : "browse") as "browse" | "chat";

const browseHref = (() => {
  const u = new URL(url);
  u.searchParams.delete("mode");
  const q = u.searchParams.toString();
  return u.pathname + (q ? `?${q}` : "");
})();

const chatHref = (() => {
  const u = new URL(url);
  u.searchParams.set("mode", "chat");
  return u.pathname + "?" + u.searchParams.toString();
})();
---

<div class="prompton-mode-toggle" role="group" aria-label="Documentation mode">
  <a
    href={browseHref}
    data-prompton-mode-link="browse"
    title="Browse docs (B)"
    aria-current={mode === "browse" ? "true" : undefined}
  >Browse</a>
  <a
    href={chatHref}
    data-prompton-mode-link="chat"
    title="Chat with docs (C)"
    aria-current={mode === "chat" ? "true" : undefined}
  >Chat</a>
</div>
