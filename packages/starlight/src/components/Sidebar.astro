---
import Default from "@astrojs/starlight/components/Sidebar.astro";
---

{/*
  Two labelled groups, not one block: the rule belongs *between* Chats and Docs.
  It previously sat inside the same element as the "Docs" heading, which drew a
  divider between that heading and the tree it labels.

  Both groups render in either mode. Chat docks beside the docs now rather than
  replacing them, so the sidebar is shared chrome — showing this only in chat
  mode made the nav jump down every time the panel opened.
*/}
<nav class="prompton-history" aria-label="Chat history">
  <div class="prompton-history__header">
    <h2 class="prompton-history__title">Chats</h2>
    <button type="button" class="prompton-history__new" data-prompton-new-chat>
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
        <path d="M8 3.5v9M3.5 8h9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
      New
    </button>
  </div>
  <ul class="prompton-history__list" data-prompton-session-list>
    <!-- Filled client-side from localStorage -->
  </ul>
</nav>
<p class="prompton-history__title prompton-history__title--docs">Docs</p>
<Default>
  <slot />
</Default>

<script>
  const STORAGE_KEY = "prompton_sessions";
  const SESSIONS_EVENT = "prompton:sessions";
  const DEFAULT_TITLE = "New chat";
  const MAX = 20;

  function isEmptyTitle(title) {
    const t = (title || "").trim();
    return !t || t === DEFAULT_TITLE;
  }

  function readSessions() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter((s) => s && typeof s.id === "string" && typeof s.title === "string")
        .sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0))
        .slice(0, MAX);
    } catch {
      return [];
    }
  }

  function writeSessions(sessions) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(sessions.slice(0, MAX)));
    window.dispatchEvent(new CustomEvent(SESSIONS_EVENT));
  }

  function pruneEmpty(keepId) {
    const next = readSessions().filter(
      (s) => !isEmptyTitle(s.title) || (keepId != null && s.id === keepId),
    );
    writeSessions(next);
    return next;
  }

  function currentSessionId() {
    const match = document.cookie.match(/(?:^|; )prompton_sid=([^;]*)/);
    return match?.[1] ? decodeURIComponent(match[1]) : null;
  }

  function setCookie(id) {
    document.cookie = `prompton_sid=${encodeURIComponent(id)}; path=/; max-age=31536000; SameSite=Lax`;
  }

  function ensureCookie() {
    let id = currentSessionId();
    if (!id) {
      id = crypto.randomUUID();
      setCookie(id);
    }
    return id;
  }

  function renderSessionList() {
    const list = document.querySelector("[data-prompton-session-list]");
    if (!list) return;
    ensureCookie();
    pruneEmpty(null);
    const active = currentSessionId();
    const visible = readSessions().filter((s) => !isEmptyTitle(s.title));
    list.replaceChildren();
    if (visible.length === 0) {
      const empty = document.createElement("li");
      empty.className = "prompton-history__empty";
      empty.textContent = "Ask a question to start one.";
      list.appendChild(empty);
      return;
    }
    for (const session of visible) {
      const row = document.createElement("li");
      row.className = "prompton-history__row";

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "prompton-history__item";
      btn.dataset.promptonSessionId = session.id;
      btn.textContent = session.title || DEFAULT_TITLE;
      btn.title = session.title || DEFAULT_TITLE;
      if (session.id === active) btn.setAttribute("aria-current", "true");

      const del = document.createElement("button");
      del.type = "button";
      del.className = "prompton-history__delete";
      del.dataset.promptonDeleteSession = session.id;
      del.setAttribute("aria-label", `Delete ${session.title || "chat"}`);
      del.title = "Delete chat";
      del.innerHTML =
        '<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">' +
        '<path d="m4.5 4.5 7 7M11.5 4.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>';

      row.append(btn, del);
      list.appendChild(row);
    }
  }

  function syncSidebarChatBits() {
    renderSessionList();
  }

  function goChat() {
    const u = new URL(window.location.href);
    u.searchParams.set("mode", "chat");
    const next = u.pathname + "?" + u.searchParams.toString();
    const current = window.location.pathname + window.location.search;
    if (current === next) window.location.reload();
    else window.location.href = next;
  }

  function newChat() {
    const id = crypto.randomUUID();
    pruneEmpty(null);
    setCookie(id);
    goChat();
  }

  function switchSession(id) {
    pruneEmpty(id);
    setCookie(id);
    goChat();
  }

  function deleteSession(id) {
    const remaining = readSessions().filter((s) => s.id !== id);
    writeSessions(remaining);
    if (currentSessionId() === id) {
      const next = remaining[0]?.id ?? crypto.randomUUID();
      setCookie(next);
      goChat();
      return;
    }
    renderSessionList();
  }

  syncSidebarChatBits();
  document.addEventListener("astro:page-load", syncSidebarChatBits);
  window.addEventListener(SESSIONS_EVENT, renderSessionList);
  window.addEventListener("prompton:mode", syncSidebarChatBits);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest("[data-prompton-new-chat]")) {
      event.preventDefault();
      newChat();
      return;
    }
    const del = target.closest("[data-prompton-delete-session]");
    if (del instanceof HTMLElement && del.dataset.promptonDeleteSession) {
      event.preventDefault();
      event.stopPropagation();
      deleteSession(del.dataset.promptonDeleteSession);
      return;
    }
    const item = target.closest("[data-prompton-session-id]");
    if (item instanceof HTMLElement && item.dataset.promptonSessionId) {
      event.preventDefault();
      const id = item.dataset.promptonSessionId;
      if (id !== currentSessionId()) switchSession(id);
    }
  });
</script>
