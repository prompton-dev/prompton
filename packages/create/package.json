{
  "name": "create-prompton",
  "version": "0.1.0",
  "description": "Scaffold a Prompton conversational Starlight docs site on Cloudflare",
  "type": "module",
  "bin": {
    "create-prompton": "./dist/cli.js"
  },
  "files": ["dist", "template"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-template.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/create"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "keywords": ["prompton", "starlight", "cloudflare", "create", "docs", "rag"],
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
