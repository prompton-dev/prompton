{
  "name": "my-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro sync && tsc --noEmit -p tsconfig.typecheck.json",
    "preview": "astro build && astro preview",
    "index": "prompton-index --content src/content/docs --out .prompton/index",
    "reindex": "curl -X POST -H \"x-prompton-reindex-secret: ${PROMPTON_REINDEX_SECRET:-dev-reindex-secret}\" http://127.0.0.1:4321/api/prompton/reindex",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.81",
    "@astrojs/cloudflare": "^14.2.4",
    "@astrojs/react": "^6.0.4",
    "@astrojs/starlight": "^0.41.8",
    "@cloudflare/ai-chat": "^0.10.2",
    "@prompton-dev/agent": "^0.1.3",
    "@prompton-dev/indexer": "^0.1.3",
    "@prompton-dev/starlight": "^0.1.3",
    "@prompton-dev/ui": "^0.1.3",
    "agents": "^0.21.0",
    "ai": "^7.0.78",
    "astro": "^7.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
