PUBLIC_PROMPTON_AGENT=DocsAgent

# Local preview only — set the same value as a Worker secret for deploy:
#   echo "$PROMPTON_REINDEX_SECRET" | npx wrangler secret put PROMPTON_REINDEX_SECRET
# Reindex with:
#   curl -X POST -H "x-prompton-reindex-secret: $PROMPTON_REINDEX_SECRET" https://<worker>/api/prompton/reindex
PROMPTON_REINDEX_SECRET=dev-reindex-secret
