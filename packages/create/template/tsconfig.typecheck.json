{
  // `astro check` needs a TypeScript API that TS 7 no longer exposes, and the
  // default tsconfig pulls dependency .ts sources into the program via allowJs.
  // This narrows the program to the starter's own TypeScript (worker + env).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
