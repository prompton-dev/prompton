{
  "name": "@prompton-dev/indexer",
  "version": "0.1.1",
  "description": "Index Starlight content into Vectorize and KV for Prompton RAG",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "bin": {
    "prompton-index": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/indexer"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "dependencies": {
    "@prompton-dev/core": "workspace:*",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "astro": "^7.2.6",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
