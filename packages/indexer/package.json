{
  "name": "@prompton/indexer",
  "version": "0.1.0",
  "description": "Index Starlight content into Vectorize and KV for Prompton RAG",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    }
  },
  "bin": {
    "prompton-index": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@prompton/core": "workspace:*",
    "gray-matter": "^4.0.3",
    "glob": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "astro": "^7.2.4",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
