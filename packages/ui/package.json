{
  "name": "@prompton-dev/ui",
  "version": "0.1.2",
  "description": "Prompton chat UI components for Astro Starlight",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/ui"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "@cloudflare/ai-chat": "^0.10.0",
    "agents": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@prompton-dev/core": "workspace:*",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.81",
    "@cloudflare/ai-chat": "^0.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "agents": "^0.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
