{
  "name": "@prompton-dev/ui",
  "version": "0.1.0",
  "description": "Prompton chat UI components for Astro Starlight",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompton-dev/prompton.git",
    "directory": "packages/ui"
  },
  "homepage": "https://prompton.dev",
  "bugs": {
    "url": "https://github.com/prompton-dev/prompton/issues"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^2.0.0 || ^3.0.0",
    "@cloudflare/ai-chat": "^0.10.0",
    "agents": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@prompton-dev/core": "workspace:*",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@cloudflare/ai-chat": "^0.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "agents": "^0.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
